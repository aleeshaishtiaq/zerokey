# FastAPI Auth0 resource-server configuration. Leave the allowlist empty to deny all data access.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ALLOWED_SUBJECTS=

# Exact browser origins allowed to call the API. Include the installed extension's origin when configured.
CORS_ALLOWED_ORIGINS=

# Set to the persistent disk path on Render. The local default is used when unset.
TELEMETRY_LOG_PATH=
