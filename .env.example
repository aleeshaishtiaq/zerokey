# FastAPI Auth0 resource-server configuration. Leave the allowlist empty to deny all data access.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ALLOWED_SUBJECTS=

# Exact browser origins allowed to call the API. Comma-separated; include the extension origin if used.
CORS_ALLOWED_ORIGINS=
VERCEL_FRONTEND_ORIGIN=https://YOUR-FRONTEND.vercel.app
VERCEL_DASHBOARD_ORIGIN=https://YOUR-DASHBOARD.vercel.app

# Local file path only; Vercel serverless filesystems are not durable between invocations.
TELEMETRY_LOG_PATH=
