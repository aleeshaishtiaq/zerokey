# FastAPI Auth0 resource-server configuration. Leave the allowlist empty to deny all data access.
AUTH0_DOMAIN=dev-g642lc64chdvl4p4.us.auth0.com
AUTH0_AUDIENCE=https://zerokey-fyp-api
AUTH0_ALLOWED_SUBJECTS=

# Exact browser origins allowed to call the API. Comma-separated.
# Browser and Chrome extension origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://zerokey-2fvk.vercel.app,chrome-extension://dknfcifmcoifbnhifooeichkinilladn,chrome-extension://medfnjlndpclielllbmjkpfencobolke,chrome-extension://mpgmppmjgfddgleipgpjofdohancoiaf
VERCEL_FRONTEND_ORIGIN=https://YOUR-FRONTEND.vercel.app
VERCEL_DASHBOARD_ORIGIN=https://YOUR-DASHBOARD.vercel.app

# Local file path only; Vercel serverless filesystems are not durable between invocations.
TELEMETRY_LOG_PATH=data/raw/zerokey_captured/telemetry_log.jsonl

# Supabase PostgreSQL connection string (Supabase > Project Settings > Database >
# Connection string > URI). Paste it as-is: postgres://, postgresql:// and
# postgresql+psycopg2:// all work, and sslmode=require is added automatically.
# URL-encode special characters in the password (@ -> %40, # -> %23).
# Leave empty locally to use the JSONL fallback. On Vercel it is REQUIRED,
# otherwise the API answers 503 "DATABASE_URL is not configured on the server".
# The telemetry_records table and any missing columns are created automatically.
# Example: postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
